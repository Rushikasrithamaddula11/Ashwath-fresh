rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Public readable collections (Products, Categories, Settings)
    match /products/{productId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Customer Profiles
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn();
      allow list, delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      // Anyone can create an order (guest checkout supported)
      allow create: if true;
      // Customers can read their own order; Admins can read all
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      // Only admins can update or delete orders
      allow update, delete: if isAdmin();
    }

  }
}
