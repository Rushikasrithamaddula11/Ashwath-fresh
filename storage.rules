rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read for product images and brand logos
    match /products/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }

    match /brand/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
